<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- *** CAMBIO PRINCIPAL: Apunta al nuevo padre *** -->
  <parent>
    <groupId>com.urbango</groupId>
    <artifactId>urbango-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>users-service</artifactId>
  <name>users-service</name>
  <description>microservicio para gestionar usuarios de UrbanGo</description>

  <dependencies>
    <!-- 1. Spring Data JPA: Necesario para @Entity, @Table, @Id, @Column, JpaRepository, etc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- 2. Spring Web: Aunque la entidad en sí no lo usa, el microservicio probablemente
         necesitará exponer endpoints REST (@RestController, etc.) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 3. Driver PostgreSQL: Para conectar con tu base de datos PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope> <!-- Es necesario en tiempo de ejecución -->
    </dependency>

    <!-- 4. Lombok: Para reducir código boilerplate (@Data, @NoArgsConstructor, etc.) -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional> <!-- Es opcional en runtime, procesado en compilación -->
    </dependency>

    <!-- 5. Spring Boot Actuator (Recomendado): Para endpoints de monitoreo y gestión -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 6. Spring Boot Starter Test (Esencial para pruebas) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope> <!-- Solo necesario para la fase de test -->
    </dependency>

    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Plugin de Spring Boot para crear el JAR ejecutable -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Excluir Lombok del JAR final si se desea (ya hizo su trabajo) -->
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>